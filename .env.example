# --- LLM ---
# Set ONE (or both) of these keys. Gemini's free tier is recommended
# for development / hackathon prep — no credit card required.
# Get a free key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional — if you also have OpenAI credits:
OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Force a specific provider ("gemini" or "openai").
# Leave blank to auto-detect based on which key is set.
# LLM_PROVIDER=

# Leave BOTH keys unset to run everything in DRY-RUN mode (deterministic
# offline heuristics in src/llm/client.ts) — useful for verifying the pipeline
# wiring without spending API credits.
